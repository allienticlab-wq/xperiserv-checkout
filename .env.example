# Allientic Checkout — Production Environment Template
# Domain: https://checkout.xperiserv.in
APP_URL="https://checkout.xperiserv.in"
NODE_ENV="production"
PORT="3000"

# Cloud SQL PostgreSQL Runtime Credentials (Object Pool Method)
SQL_HOST="/cloudsql/instance"
SQL_DB_NAME="allientic_checkout"
SQL_USER="app_user"
SQL_PASSWORD="YOUR_SQL_PASSWORD"

# Drizzle Schema Migration Admin Credentials
SQL_ADMIN_USER="admin_user"
SQL_ADMIN_PASSWORD="YOUR_SQL_ADMIN_PASSWORD"

# Security & Credential Encryption
ENCRYPTION_MASTER_KEY="replace_with_32_byte_hex_master_key_for_aes_256_gcm"
WEBHOOK_SIGNING_SECRET="whsec_allientic_default_hmac_sha256_key"

# PayU India Merchant Configuration
PAYU_ENV="SANDBOX"
PAYU_MERCHANT_KEY="gtKFFx"
PAYU_MERCHANT_SALT="4R38IvwiV57FwVpsgOvTXBdLE4tHUXFW"
PAYU_WEBHOOK_SECRET="payu_whsec_key"

# Zoho Payments Merchant Configuration
ZOHO_PAYMENTS_ENV="SANDBOX"
ZOHO_PAYMENTS_ACCOUNT_ID="zoho_acct_id"
ZOHO_PAYMENTS_CLIENT_ID="1000.ZOHO_CLIENT_ID"
ZOHO_PAYMENTS_CLIENT_SECRET="zoho_client_secret"
ZOHO_PAYMENTS_WEBHOOK_SECRET="zoho_whsec_key"

# Mailgun SMTP Email Notifications (Allientic Transactional Mailer)
MAILGUN_DOMAIN="mg.xperiserv.in"
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT="587"
SMTP_USER="postmaster@mg.xperiserv.in"
SMTP_PASSWORD="YOUR_MAILGUN_SMTP_PASSWORD"
SMTP_FROM="Allientic Checkout <checkout@mg.xperiserv.in>"

# AI Studio Runtime Key
GEMINI_API_KEY="MY_GEMINI_API_KEY"
