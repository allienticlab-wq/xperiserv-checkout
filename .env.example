# Allientic Checkout — Production Environment Template
# Domain: https://checkout.xperiserv.in
APP_URL="https://checkout.xperiserv.in"
NODE_ENV="production"
PORT="3000"

# Production Admin Portal Credentials
ADMIN_USER_ID="admin@xperiserv.in"
ADMIN_PASSWORD="XperiServ@2026#Admin"

# PostgreSQL Connection URL (Easypanel / Self-Hosted Docker)
DATABASE_URL="postgres://db:YOUR_DB_PASSWORD@checkout_db:5432/db?sslmode=disable"

# Cloud SQL PostgreSQL Runtime Credentials (Optional Alternative)
SQL_HOST="/cloudsql/instance"
SQL_DB_NAME="allientic_checkout"
SQL_USER="app_user"
SQL_PASSWORD="YOUR_SQL_PASSWORD"

# Security & Credential Encryption
ENCRYPTION_MASTER_KEY="replace_with_32_byte_hex_master_key_for_aes_256_gcm"
WEBHOOK_SIGNING_SECRET="whsec_allientic_default_hmac_sha256_key"

# PayU India Merchant Configuration (Production)
PAYU_ENV="PRODUCTION"
PAYU_MERCHANT_KEY="YOUR_PAYU_LIVE_MERCHANT_KEY"
PAYU_MERCHANT_SALT="YOUR_PAYU_LIVE_MERCHANT_SALT"
PAYU_WEBHOOK_SECRET="YOUR_PAYU_WEBHOOK_SECRET"

# Zoho Payments Merchant Configuration (Production)
ZOHO_PAYMENTS_ENV="PRODUCTION"
ZOHO_PAYMENTS_ACCOUNT_ID="YOUR_ZOHO_PAYMENTS_ACCOUNT_ID"
ZOHO_PAYMENTS_CLIENT_ID="YOUR_ZOHO_PAYMENTS_CLIENT_ID"
ZOHO_PAYMENTS_CLIENT_SECRET="YOUR_ZOHO_PAYMENTS_CLIENT_SECRET"
ZOHO_PAYMENTS_WEBHOOK_SECRET="YOUR_ZOHO_PAYMENTS_WEBHOOK_SECRET"

# Mailgun SMTP Email Notifications (Allientic Transactional Mailer)
MAILGUN_DOMAIN="mg.xperiserv.in"
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT="587"
SMTP_USER="postmaster@mg.xperiserv.in"
SMTP_PASSWORD="YOUR_MAILGUN_SMTP_PASSWORD"
SMTP_FROM="Allientic Checkout <checkout@mg.xperiserv.in>"

